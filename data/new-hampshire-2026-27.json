  "trapping_license": "Trapping license required (fees not extracted \u2014 see NHFG licensing).",
  "trapper_report": "Annual Trapper's Report due April 30 (all licensed trappers).",
  "hunter_registration": "All furbearers taken by HUNTING (coyote, fisher, raccoon, red/gray fox, opossum, mink, weasel, skunk, muskrat) must be registered online within 24 hours of take.",
  "fisher_sealing": "All harvested fisher must be sealed and the lower jaw submitted at the time of sealing.",
  "hunting_hours": "Furbearer hunting hours: 1/2 hour before sunrise to 1/2 hour after sunset."
