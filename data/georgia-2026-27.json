 "license_summary": {
  "trapping_license": "A Georgia trapping license is required for trapping and for selling fur, hides and pelts. A hunting license is required for hunting take of furbearers.",
  "reporting": "All trappers must report in writing (Georgia Trapper Questionnaire) the number of furs, hides or pelts taken and to whom sold within 10 days after the close of trapping season. Traps must be inspected at least once each 24 hours and be stamped or tagged with the owner's name or permanent trapper ID.",
  "bobcat_otter_tagging": "All bobcats and otters exported out of Georgia must have a federal export tag attached by State personnel no later than 10 days after the close of trapping season."
 },
